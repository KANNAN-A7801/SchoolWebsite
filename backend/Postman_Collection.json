	"item": [
		{
			"name": "1. Signup (New Class 5 Student/Parent)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"newstudent5@school.com\",\n  \"password\": \"student123\",\n  \"fullName\": \"Smith Sam\",\n  \"role\": \"ROLE_STUDENT\",\n  \"gradeNumber\": 5\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/auth/signup",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"auth",
						"signup"
					]
				}
			},
			"response": []
		},
